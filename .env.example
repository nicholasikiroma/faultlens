# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
REDIS_URL="redis://localhost:6379"
FAULTLENS_ADMIN_TOKEN="replace-with-local-admin-token"
FAULTLENS_WORKSPACE_ID="workspace-1"
FAULTLENS_ADMIN_ACTOR="local-admin"
FAULTLENS_API_HOST="127.0.0.1"
FAULTLENS_API_PORT="3000"
# Set to 1 to mount POST /hooks/:token. That path accepts simulated traffic only.
# FAULTLENS_SIMULATED_WEBHOOKS=1

# Optional Node SDK example host (npm run start:sdk-example).
FAULTLENS_API_URL="http://127.0.0.1:3000"
# Raw key shown once by npm run ingest-key -- create <integrationId>.
# FAULTLENS_INGEST_KEY="flk_..."
# The integration's signing secret, not the provider's webhook secret or API key.
# FAULTLENS_SIGNING_SECRET="replace-with-integration-signing-secret"

# Optional Read-Only AI Investigation Agent (defaults to disabled: deterministic mode only).
# FAULTLENS_AI_ENABLED=0
# FAULTLENS_AI_AUTO_INVESTIGATE=1
# FAULTLENS_AI_PROVIDER=openai-compatible # openai-compatible | anthropic | mock
# FAULTLENS_AI_BASE_URL=http://127.0.0.1:11434/v1
# FAULTLENS_AI_MODEL=qwen2.5:14b-instruct
# FAULTLENS_AI_API_KEY=""
# FAULTLENS_AI_MAX_TOOL_CALLS=8
# FAULTLENS_AI_TIMEOUT_MS=60000
# Optional USD rates per 1M tokens for custom/private hosted models:
# FAULTLENS_AI_INPUT_COST_PER_1M=
# FAULTLENS_AI_OUTPUT_COST_PER_1M=

# Optional automated data retention purge (disabled by default in local dev).
# FAULTLENS_RETENTION_ENABLED=0
# FAULTLENS_RETENTION_METADATA_DAYS=30
# FAULTLENS_RETENTION_PAYLOAD_DAYS=7

