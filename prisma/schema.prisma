generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProcessingState {
  RECEIVED
  QUEUED
  PROCESSED
  FAILED
}

enum TrustTier {
  A
  B
  C
}

enum VerificationState {
  RECEIVED
  VERIFIED
  REJECTED
}

enum HandlerState {
  PENDING
  PROCESSED
  FAILED
}

enum SourceKind {
  DELIVERY_ATTEMPT
  WEBHOOK_EVENT
  FIXTURE
}

model Integration {
  id            String @id @default(uuid())
  workspaceId   String @map("workspace_id")
  endpointToken String @unique @map("endpoint_token")
  signingSecret String @map("signing_secret")

  events   WebhookEvent[]
  attempts DeliveryAttempt[]

  @@map("integrations")
}

model WebhookEvent {
  id                  String          @id @default(uuid())
  integrationId       String          @map("integration_id")
  externalEventId     String?         @map("external_event_id")
  eventType           String?         @map("event_type")
  occurredAt          DateTime?       @map("occurred_at")
  firstReceivedAt     DateTime        @map("first_received_at")
  traceId             String?         @map("trace_id")
  payloadDigest       String          @map("payload_digest")
  redactedPayloadJson Json?           @map("redacted_payload_json")
  processingState     ProcessingState @map("processing_state")
  workspaceId         String          @map("workspace_id")

  integration Integration       @relation(fields: [integrationId], references: [id])
  attempts    DeliveryAttempt[]
  outboxRows  Outbox[]

  @@unique([integrationId, externalEventId])
  @@map("webhook_events")
}

model DeliveryAttempt {
  id                String            @id @default(uuid())
  eventId           String?           @map("event_id")
  integrationId     String            @map("integration_id")
  receivedAt        DateTime          @map("received_at")
  httpStatus        Int?              @map("http_status")
  durationMs        Int?              @map("duration_ms")
  verificationState VerificationState @map("verification_state")
  handlerState      HandlerState      @map("handler_state")
  errorCode         String?           @map("error_code")
  correlationId     String            @map("correlation_id")
  workspaceId       String            @map("workspace_id")

  event       WebhookEvent? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  integration Integration   @relation(fields: [integrationId], references: [id])
  outboxRows  Outbox[]

  @@map("delivery_attempts")
}

model Evidence {
  id             String     @id @default(uuid())
  sourceKind     SourceKind @map("source_kind")
  sourceRecordId String     @map("source_record_id")
  summary        String
  sha256Digest   String     @map("sha256_digest")
  trustTier      TrustTier  @map("trust_tier")
  workspaceId    String     @map("workspace_id")

  @@map("evidence")
}

model Outbox {
  id         String    @id @default(uuid())
  eventId    String?   @map("event_id")
  attemptId  String    @map("attempt_id")
  enqueuedAt DateTime? @map("enqueued_at")

  event   WebhookEvent?   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attempt DeliveryAttempt @relation(fields: [attemptId], references: [id])

  @@map("outbox")
}
