generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProcessingState {
  RECEIVED
  QUEUED
  PROCESSED
  FAILED
}

enum TrustTier {
  A
  B
  C
}

enum VerificationState {
  RECEIVED
  VERIFIED
  REJECTED
}

enum HandlerState {
  PENDING
  PROCESSED
  FAILED
}

enum SourceKind {
  DELIVERY_ATTEMPT
  WEBHOOK_EVENT
  FIXTURE
  FLIGHT_RECORDER_EPISODE
  DOWNSTREAM_SPAN
  HOST_EXCEPTION
  SOCKET_TIMING
}

enum FailureClass {
  AUTH_FAILURE
  RATE_LIMIT
  NETWORK_TIMEOUT
  UPSTREAM_5XX
  SCHEMA_MISMATCH
  INVALID_SIGNATURE
  DUPLICATE_DELIVERY
  OUT_OF_ORDER
  INGRESS_ABORTED
  DECRYPT_FAILURE
  DOWNSTREAM_NETWORK_ERROR
  UNHANDLED_EXCEPTION
  ASYNC_ESCAPE_FAILURE
  UNKNOWN
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  ARCHIVED
}

enum EpistemicStatus {
  OBSERVED
  INFERRED
  HYPOTHESIS
  UNVERIFIED
}

enum HypothesisConfidence {
  HIGH
  MEDIUM
  LOW
}

enum FeedbackRating {
  USEFUL
  INCORRECT
}

enum HypothesisFeedbackRating {
  USEFUL
  INCORRECT
  UNVERIFIED
}

enum AuditAction {
  INCIDENT_STATUS_CHANGED
  FINDING_RATED
  HYPOTHESIS_RATED
  AI_INVESTIGATION_REQUESTED
}

enum AuditObjectType {
  INCIDENT
  FINDING
  HYPOTHESIS
  INVESTIGATION_RUN
}

enum RunMode {
  RULES
  AI_ASSISTED
}

enum RunState {
  NOT_STARTED
  QUEUED
  RUNNING
  NEEDS_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

enum ToolCallStatus {
  SUCCEEDED
  FAILED
  REJECTED
}

model Integration {
  id            String @id @default(uuid())
  workspaceId   String @map("workspace_id")
  endpointToken String @unique @map("endpoint_token")
  signingSecret String @map("signing_secret")
  environment   String @default("local")
  endpoint      String @default("/")

  events     WebhookEvent[]
  attempts   DeliveryAttempt[]
  ingestKeys IngestKey[]

  @@map("integrations")
}

model IngestKey {
  id            String    @id @default(uuid())
  integrationId String    @map("integration_id")
  workspaceId   String    @map("workspace_id")
  environment   String
  keyHash       String    @unique @map("key_hash")
  createdAt     DateTime  @map("created_at")
  revokedAt     DateTime? @map("revoked_at")

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, integrationId])
  @@map("ingest_keys")
}

model WebhookEvent {
  id                  String          @id @default(uuid())
  integrationId       String          @map("integration_id")
  externalEventId     String?         @map("external_event_id")
  eventType           String?         @map("event_type")
  occurredAt          DateTime?       @map("occurred_at")
  firstReceivedAt     DateTime        @map("first_received_at")
  traceId             String?         @map("trace_id")
  payloadDigest       String          @map("payload_digest")
  redactedPayloadJson Json?           @map("redacted_payload_json")
  processingState     ProcessingState @map("processing_state")
  workspaceId         String          @map("workspace_id")

  integration       Integration        @relation(fields: [integrationId], references: [id])
  attempts          DeliveryAttempt[]
  outboxRows        Outbox[]
  findings          Finding[]
  incidentLinks     IncidentEvent[]
  investigationRuns InvestigationRun[]

  @@unique([integrationId, externalEventId])
  @@map("webhook_events")
}

model DeliveryAttempt {
  id                String            @id @default(uuid())
  eventId           String?           @map("event_id")
  integrationId     String            @map("integration_id")
  receivedAt        DateTime          @map("received_at")
  httpStatus        Int?              @map("http_status")
  durationMs        Int?              @map("duration_ms")
  senderWaitMs      Int?              @map("sender_wait_ms")
  verificationState VerificationState @map("verification_state")
  handlerState      HandlerState      @map("handler_state")
  errorCode         String?           @map("error_code")
  correlationId     String            @map("correlation_id")
  workspaceId       String            @map("workspace_id")

  event       WebhookEvent? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  integration Integration   @relation(fields: [integrationId], references: [id])
  outboxRows  Outbox[]

  @@map("delivery_attempts")
}

model Evidence {
  id                 String     @id @default(uuid())
  sourceKind         SourceKind @map("source_kind")
  sourceRecordId     String     @map("source_record_id")
  summary            String
  sha256Digest       String     @map("sha256_digest")
  trustTier          TrustTier  @map("trust_tier")
  workspaceId        String     @map("workspace_id")
  recordedAt         DateTime?  @map("recorded_at")
  structuredDataJson Json?      @map("structured_data_json")

  findingLinks FindingEvidence[]

  @@map("evidence")
}

model Outbox {
  id         String    @id @default(uuid())
  eventId    String?   @map("event_id")
  attemptId  String    @map("attempt_id")
  enqueuedAt DateTime? @map("enqueued_at")

  event   WebhookEvent?   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attempt DeliveryAttempt @relation(fields: [attemptId], references: [id])

  @@map("outbox")
}

model Incident {
  id            String         @id @default(uuid())
  workspaceId   String         @map("workspace_id")
  fingerprint   String
  integrationId String         @map("integration_id")
  environment   String
  failureClass  FailureClass   @map("failure_class")
  endpoint      String
  ruleVersion   String         @map("rule_version")
  status        IncidentStatus
  firstSeenAt   DateTime       @map("first_seen_at")
  lastSeenAt    DateTime       @map("last_seen_at")
  eventCount    Int            @map("event_count")

  events     IncidentEvent[]
  findings   Finding[]
  runs       InvestigationRun[]
  hypotheses Hypothesis[]
  questions  IncidentQuestion[]

  @@unique([workspaceId, fingerprint, ruleVersion])
  @@map("incidents")
}

model IncidentEvent {
  incidentId String   @map("incident_id")
  eventId    String   @map("event_id")
  linkedAt   DateTime @map("linked_at")

  incident Incident     @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  event    WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([incidentId, eventId])
  @@map("incident_events")
}

model Finding {
  id           String       @id @default(uuid())
  incidentId   String       @map("incident_id")
  eventId      String       @map("event_id")
  ruleId       String       @map("rule_id")
  ruleVersion  String       @map("rule_version")
  failureClass FailureClass @map("failure_class")
  explanation  String
  certainty    String
  workspaceId  String       @map("workspace_id")

  incident Incident          @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  event    WebhookEvent      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  evidence FindingEvidence[]
  feedback Feedback[]

  @@unique([eventId, ruleId, ruleVersion])
  @@map("findings")
}

model FindingEvidence {
  findingId  String @map("finding_id")
  evidenceId String @map("evidence_id")

  finding  Finding  @relation(fields: [findingId], references: [id], onDelete: Restrict)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@id([findingId, evidenceId])
  @@map("finding_evidence")
}

model InvestigationRun {
  id             String    @id @default(uuid())
  workspaceId    String    @default("workspace-1") @map("workspace_id")
  incidentId     String    @map("incident_id")
  eventId        String?   @map("event_id")
  mode           RunMode
  state          RunState
  triggeredBy    String    @default("system") @map("triggered_by")
  triggerReason  String?   @map("trigger_reason")
  modelId        String?   @map("model_id")
  promptVersion  String?   @map("prompt_version")
  rulesetVersion String    @map("ruleset_version")
  tokenUsage     Json?     @map("token_usage")
  toolCallCount  Int       @default(0) @map("tool_call_count")
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  summaryJson    Json?     @map("summary_json")
  startedAt      DateTime  @map("started_at")
  endedAt        DateTime? @map("ended_at")

  incident   Incident      @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  event      WebhookEvent? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  toolCalls  ToolCall[]
  hypotheses Hypothesis[]

  @@unique([eventId, incidentId, mode, rulesetVersion])
  @@index([workspaceId, incidentId, startedAt])
  @@map("investigation_runs")
}

model ToolCall {
  id                 String         @id @default(uuid())
  investigationRunId String         @map("investigation_run_id")
  workspaceId        String         @map("workspace_id")
  stepIndex          Int            @map("step_index")
  toolName           String         @map("tool_name")
  safeArgumentsJson  Json           @map("safe_arguments_json")
  resultEvidenceIds  String[]       @map("result_evidence_ids")
  resultSummary      String         @map("result_summary")
  status             ToolCallStatus
  errorCode          String?        @map("error_code")
  startedAt          DateTime       @map("started_at")
  endedAt            DateTime       @map("ended_at")

  investigationRun InvestigationRun @relation(fields: [investigationRunId], references: [id], onDelete: Cascade)

  @@index([workspaceId, investigationRunId, stepIndex])
  @@map("tool_calls")
}

model Hypothesis {
  id                 String                   @id @default(uuid())
  workspaceId        String                   @map("workspace_id")
  incidentId         String                   @map("incident_id")
  investigationRunId String                   @map("investigation_run_id")
  title              String
  reasoning          String
  epistemicStatus    EpistemicStatus          @map("epistemic_status")
  confidence         HypothesisConfidence
  citedEvidenceIds   String[]                 @map("cited_evidence_ids")
  missingInformation String[]                 @map("missing_information")
  suggestedCheck     String                   @map("suggested_check")
  remediationJson    Json?                    @map("remediation_json")
  feedback           HypothesisFeedbackRating @default(UNVERIFIED)
  createdAt          DateTime                 @map("created_at")

  incident         Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  investigationRun InvestigationRun @relation(fields: [investigationRunId], references: [id], onDelete: Cascade)

  @@index([workspaceId, incidentId, createdAt])
  @@map("hypotheses")
}

model IncidentQuestion {
  id               String          @id @default(uuid())
  workspaceId      String          @map("workspace_id")
  incidentId       String          @map("incident_id")
  actor            String
  question         String
  answer           String
  epistemicStatus  EpistemicStatus @map("epistemic_status")
  citedEvidenceIds String[]        @map("cited_evidence_ids")
  modelId          String?         @map("model_id")
  tokenUsage       Json?           @map("token_usage")
  toolCallCount    Int             @default(0) @map("tool_call_count")
  createdAt        DateTime        @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, incidentId, createdAt])
  @@map("incident_questions")
}

model Feedback {
  id          String         @id @default(uuid())
  workspaceId String         @map("workspace_id")
  findingId   String         @map("finding_id")
  actor       String
  rating      FeedbackRating
  note        String?
  createdAt   DateTime       @map("created_at")

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)

  @@unique([findingId, actor])
  @@index([workspaceId, findingId])
  @@map("feedback")
}

model AuditEvent {
  id          String          @id @default(uuid())
  workspaceId String          @map("workspace_id")
  actor       String
  action      AuditAction
  objectType  AuditObjectType @map("object_type")
  objectId    String          @map("object_id")
  oldState    String?         @map("old_state")
  newState    String          @map("new_state")
  timestamp   DateTime

  @@index([workspaceId, objectType, objectId, timestamp])
  @@map("audit_events")
}
