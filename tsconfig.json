{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["import"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "src/prisma/db.ts",
    "src/prisma/sql.ts",
    "prisma.config.ts"
  ],
  "exclude": [
    "apps/web"
  ]
}
